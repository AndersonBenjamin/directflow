# Arquivo OPCIONAL. Sem ele o app sobe e tudo abaixo é definido pelo painel
# (senha no 1º acesso; credenciais da Meta em Configurações). O que for definido
# aqui tem prioridade e fica bloqueado no painel.

# URL pública do app, com https:// (a Meta exige HTTPS). Padrão no docker-compose.yml.
# APP_BASE_URL=https://directflow.codeshot.com.br
# Porta da VPS (só em 127.0.0.1) para onde o Nginx encaminha — veja deploy/nginx-directflow.conf
# HOST_PORT=3010

# Meta App Dashboard > Instagram > API setup with Instagram login
# IG_APP_ID=
# IG_APP_SECRET=
# Texto livre que você também cola no campo "Verify token" do webhook (gerado se ausente)
# WEBHOOK_VERIFY_TOKEN=

# Senha do painel (se ausente, é criada no 1º acesso)
# ADMIN_PASSWORD=
# Chave para criptografar tokens no banco (se ausente, é gerada em data/secret.key)
# ENCRYPTION_KEY=

# Opcionais
# GRAPH_API_VERSION=v26.0
# DB_PATH=./data/app.db
# PRIVATE_REPLY_HOURLY_LIMIT=600   # a Meta permite 750/h por conta
# HISTORY_RETENTION_DAYS=90
# TZ_OFFSET_MINUTES=-180           # fuso do gráfico (Brasília)
