# Domínio que aponta para a VPS (usado pelo Caddy para emitir o certificado HTTPS)
DOMAIN=direct.seudominio.com.br
# URL pública do app — a mesma do DOMAIN, com https:// (a Meta exige HTTPS)
APP_BASE_URL=https://direct.seudominio.com.br
PORT=3000

# Meta App Dashboard > Instagram > API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=
# Texto livre que você também cola no campo "Verify token" do webhook
WEBHOOK_VERIFY_TOKEN=

# Senha do painel (use uma senha longa)
ADMIN_PASSWORD=
# Chave para criptografar tokens no banco. Gere com: openssl rand -hex 32
ENCRYPTION_KEY=

# Opcionais
# GRAPH_API_VERSION=v26.0
# DB_PATH=./data/app.db
# PRIVATE_REPLY_HOURLY_LIMIT=600   # a Meta permite 750/h por conta
# HISTORY_RETENTION_DAYS=90
# TZ_OFFSET_MINUTES=-180           # fuso do gráfico (Brasília)
